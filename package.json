{
  "name": "l-key",
  "version": "0.1.0",
  "private": true,
  "description": "L Key \u2014 Everything Your Guitar Needs. Tune. Learn. Practice. Play.",
  "workspaces": [
    "packages/*",
    "backend",
    "admin",
    "website"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "tokens": "node packages/design-tokens/build.mjs",
    "tokens:check": "node packages/design-tokens/build.mjs --check",
    "tokens:check:web": "node packages/design-tokens/build.mjs --check --targets=web",
    "tokens:check:dart": "node packages/design-tokens/build.mjs --check --targets=dart",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile:format": "cd mobile && dart format --set-exit-if-changed .",
    "mobile:analyze": "cd mobile && flutter analyze",
    "mobile:test": "cd mobile && flutter test",
    "mobile:verify": "npm run mobile:format && npm run mobile:analyze && npm run mobile:test",
    "verify": "npm run tokens:check && npm run lint && npm run typecheck && npm run test && npm run mobile:verify"
  }
}
