{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/admin/**",
              "components/core/**",
              "components/feedback/**",
              "components/music/**",
              "components/navigation/**",
              "ui_kits/admin_portal/**",
              "ui_kits/mobile_app/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|Hanken Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, Hanken Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|actions|size|style|key|ref|className|style|children)$/]",
        "message": "<AdminHeader> doesn't accept that prop. Declared props: title, subtitle, actions, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminHeader'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<AdminHeader> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdminNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|key|ref|className|style|children)$/]",
        "message": "<AdminNavItem> doesn't accept that prop. Declared props: label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconPosition|block|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AppButton> doesn't accept that prop. Declared props: children, variant, size, icon, iconPosition, block, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost)$/]",
        "message": "<AppButton> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl|hero)$/]",
        "message": "<AppButton> size must be one of 'sm' | 'md' | 'lg' | 'xl' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppButton'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<AppButton> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|title|action|variant|padding|tone|style|key|ref|className|style|children)$/]",
        "message": "<AppCard> doesn't accept that prop. Declared props: children, label, title, action, variant, padding, tone, style."
