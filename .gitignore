# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Logs ----------
*.log
npm-debug.log*

# ---------- Node ----------
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo
coverage/
backend/dist/

# ---------- Secrets ----------
# .env.example files are committed; real values never are (CLAUDE.md §22).
.env
.env.*
!.env.example
mobile/config/*.json
!mobile/config/local.json

# ---------- Flutter / Dart ----------
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.pub-cache/
mobile/.pub/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/ephemeral/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/**/*.g.dart.bak

# Generated localisation output is reproducible from the ARB files.
mobile/lib/app/localization/generated/

# NOTE: mobile/lib/app/theme/tokens.g.dart IS committed, so a fresh clone
# builds without running the token generator first. `npm run tokens:check`
# guards it against drift.
