# L Key backend — copy to .env and fill in. Never commit a real .env.
#
# Variables marked SERVER-ONLY must never be exposed to the mobile client or
# the Admin browser bundle (CLAUDE.md §22, §24, §51).

NODE_ENV=development
APP_ENV=local
PORT=3000

# PostgreSQL (CLAUDE.md §26)
DATABASE_URL=postgresql://lkey:lkey@localhost:5432/lkey

# SERVER-ONLY. At least 32 characters.
JWT_SECRET=replace-with-a-long-random-value-at-least-32-chars

# SERVER-ONLY. Optional locally; required wherever payments are enabled.
# MYANMYANPAY_WEBHOOK_SECRET=

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
